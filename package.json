{
  "name": "csyk",
  "version": "0.0.0",
  "description": "Code-search MCP server for AI agents: compiler-grade precision, minimal tokens.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubiwdotspace/CSyk.git"
  },
  "homepage": "https://github.com/ubiwdotspace/CSyk#readme",
  "bugs": "https://github.com/ubiwdotspace/CSyk/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "code-search",
    "claude-code",
    "ai-agents",
    "lsp",
    "tree-sitter"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "corpora": "node eval/fetch.ts",
    "generate": "node eval/generate.ts",
    "eval": "node eval/run.ts",
    "agent": "node eval/agent/run.ts",
    "agent:tasks": "node eval/agent/make-tasks.ts",
    "loc": "node eval/loc/run.ts",
    "loc:report": "node eval/loc/report.ts",
    "bench": "node eval/bench.ts",
    "gate": "node eval/gate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "gpt-tokenizer": "^4.1.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "pyright": "^1.1.414",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^7.0.2",
    "vscode-languageserver-protocol": "^3.18.5",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "csyk": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "NOTICE"
  ]
}
